{
  "name": "ancient-text-transcriber",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-runtime.mjs && node scripts/prepare-paddle.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-runtime.mjs && node scripts/prepare-paddle.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:ocr-samples": "node scripts/evaluate-browser-ocr.mjs",
    "test:ocr-comparison": "node scripts/compare-methods.mjs"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "0.4.2",
    "docx": "9.10.0",
    "onnxruntime-web": "1.24.3",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "jszip": "3.10.1",
    "pdfmarkdown-ppocrv5-models": "1.0.0",
    "vite": "8.3.4"
  }
}
