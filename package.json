{
  "name": "ancient-text-transcriber",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/prepare-runtime.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-runtime.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:ocr-samples": "node scripts/evaluate-browser-ocr.mjs"
  },
  "dependencies": {
    "docx": "9.10.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "jszip": "3.10.1",
    "vite": "8.3.4"
  }
}
